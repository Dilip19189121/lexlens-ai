# ── LexLens AI backend — environment variables ──────────────────────────────
# Copy this file to `backend/.env` and fill in your real keys.
# NEVER commit the real .env file (it is git-ignored).

# Groq API keys. The backend rotates through them in order and moves to the
# next key (then to Gemini) when one hits a rate limit (HTTP 429) or is
# rejected (401/403). You can add as many as you want: GROQ_API_KEY_3, _4, ...
GROQ_API_KEY_1=gsk_your_first_groq_key_here
GROQ_API_KEY_2=gsk_your_second_groq_key_here

# Gemini API key (free tier fallback provider).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional overrides (sane defaults are built in) ─────────────────────────
# Groq model IDs tried in order (first is primary, second is fallback).
# NOTE: llama-3.1-8b-instant / llama-3.3-70b-versatile are Enterprise-only as
# of mid-2026; the gpt-oss models below are the free/cheap production choice.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Gemini model ID (flash models are the free-tier option).
# GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to run without any API keys — returns canned mock findings so
# you can demo/test the pipeline end-to-end at zero cost. Default: false.
# LLM_MOCK_MODE=false
